# Personal Execution OS - Environment Variables Template
# Copy this to .env and update values for your environment

# ===== ASP.NET Core Configuration =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ===== Database Configuration =====
# Local Development (PostgreSQL)
ConnectionStrings__PostgresConnection=Host=localhost;Port=5432;Database=PersonalExecutionOS;Username=postgres;Password=YOUR_PASSWORD_HERE

# Production (uncomment and update for your environment)
# ConnectionStrings__PostgresConnection=Host=your-db-server.com;Port=5432;Database=PersonalExecutionOS;Username=prod_user;Password=YOUR_SECURE_PASSWORD

# ===== Application Settings =====
UseHttpsRedirection=false
ApplyMigrationsOnStartup=true

# ===== Logging Configuration =====
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft=Information
Logging__LogLevel__System=Information

# ===== CORS Configuration =====
AllowedHosts=*

# ===== Angular Development Configuration =====
NG_ENVIRONMENT=development
API_BASE_URL=http://localhost:5000

# ===== Cloud Provider Configuration =====
# AWS (if deploying to AWS)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Azure (if deploying to Azure)
# AZURE_SUBSCRIPTION_ID=your_subscription_id
# AZURE_TENANT_ID=your_tenant_id
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret

# Google Cloud (if deploying to Google Cloud)
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ===== Monitoring & Logging Services =====
# Datadog (if using Datadog)
# DD_API_KEY=your_datadog_api_key
# DD_SITE=datadoghq.com
